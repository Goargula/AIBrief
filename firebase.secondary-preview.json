{
  "hosting": {
    "site": "ai-brief-arsh-20260604",
    "public": ".preview-secondary",
    "ignore": [
      "firebase.secondary-preview.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/curated-feed.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/stories/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          },
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
